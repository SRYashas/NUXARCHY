[Unit]
Description=NUXARCHY Hardware & System Control Daemon
Documentation=https://github.com/nuxarchy/nuxarchy
After=network.target sys-devices-platform-hp\x2dwmi.device

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/nuxarchy-daemon
Restart=always
RestartSec=3s

# Runtime socket directory /run/nuxarchy
RuntimeDirectory=nuxarchy
RuntimeDirectoryMode=0755

# Security sandbox settings appropriate for root hardware controllers
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/sys /proc /dev /run/nuxarchy /tmp

[Install]
WantedBy=multi-user.target
