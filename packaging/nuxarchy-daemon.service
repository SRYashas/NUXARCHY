[Unit]
Description=NUXARCHY Privileged Root Hardware & Thermal Daemon
Documentation=https://github.com/SRYashas/NUXARCHY
After=network.target dbus.service lm_sensors.service
Wants=dbus.service

[Service]
Type=simple
BusName=org.nuxarchy.Daemon
ExecStart=/usr/bin/python3 -m nuxarchy.services.daemon
Restart=always
RestartSec=3s
User=root
Group=root

# Hardware & security capabilities
AmbientCapabilities=CAP_SYS_RAWIO CAP_NET_ADMIN CAP_SYS_NICE CAP_DAC_OVERRIDE
CapabilityBoundingSet=CAP_SYS_RAWIO CAP_NET_ADMIN CAP_SYS_NICE CAP_DAC_OVERRIDE

# Security & sandboxing flags
ProtectSystem=strict
ReadWritePaths=/sys /proc /dev /run /etc
ProtectHome=true
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
