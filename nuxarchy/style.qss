/* ==========================================================================
   NUXARCHY: HP OMEN Dark Industrial Cyber Theme
   Colors:
     Background: #0A0B10
     Surface:    #14161F
     Hover:      #1C1F2E
     Border:     #222533
     Cyan:       #00E5FF
     Cyber Red:  #FF0552
     Amber:      #FFB300
     Text Muted: #8E92A4
   ========================================================================== */

* {
    font-family: "Inter", "Segoe UI", "Cantarell", sans-serif;
    outline: none;
    color: #E2E4EB;
}

QWidget {
    background-color: #0A0B10;
    color: #E2E4EB;
    font-size: 13px;
}

/* ── Main Navigation Sidebar ─────────────────────────────────────────────── */

#navSidebar {
    background-color: #0E1017;
    border-right: 1px solid #222533;
    min-width: 220px;
    max-width: 220px;
}

#navLogoContainer {
    background-color: transparent;
    padding: 20px 16px 16px 16px;
    border-bottom: 1px solid #1C1F2E;
}

#navLogoTitle {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 2px;
}

#navDaemonBadge {
    font-size: 9px;
    font-weight: 700;
    padding: 3px 6px;
    border-radius: 3px;
    letter-spacing: 1px;
}

#navDaemonBadge[online="true"] {
    background-color: rgba(0, 229, 255, 0.15);
    color: #00E5FF;
    border: 1px solid rgba(0, 229, 255, 0.4);
}

#navDaemonBadge[online="false"] {
    background-color: rgba(255, 5, 82, 0.15);
    color: #FF0552;
    border: 1px solid rgba(255, 5, 82, 0.4);
}

/* Nav Item Buttons */
QPushButton.nav-btn {
    background-color: transparent;
    border: none;
    border-left: 3px solid transparent;
    color: #8E92A4;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-align: left;
    padding: 12px 18px;
    border-radius: 0px;
}

QPushButton.nav-btn:hover {
    background-color: #14161F;
    color: #FFFFFF;
}

QPushButton.nav-btn:checked, QPushButton.nav-btn.active {
    background-color: #161A26;
    color: #00E5FF;
    border-left: 3px solid #00E5FF;
}

/* ── Content View Header & Panels ────────────────────────────────────────── */

#viewHeader {
    background-color: transparent;
    border-bottom: 1px solid #1E2230;
    padding-bottom: 12px;
    margin-bottom: 16px;
}

QLabel.view-title {
    color: #FFFFFF;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 1.5px;
}

QLabel.view-subtitle {
    color: #8E92A4;
    font-size: 12px;
}

QFrame.cyber-card {
    background-color: #14161F;
    border: 1px solid #222533;
    border-radius: 8px;
    padding: 16px;
}

QFrame.cyber-card:hover {
    border: 1px solid #2F354A;
}

QLabel.card-heading {
    color: #8E92A4;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
}

/* ── Cyber Action Buttons ────────────────────────────────────────────────── */

QPushButton.cyber-btn-primary {
    background-color: #00E5FF;
    color: #0A0B10;
    border: none;
    border-radius: 6px;
    font-weight: 800;
    font-size: 11px;
    letter-spacing: 1.2px;
    padding: 10px 22px;
}

QPushButton.cyber-btn-primary:hover {
    background-color: #33EBFF;
}

QPushButton.cyber-btn-primary:pressed {
    background-color: #00B4CC;
}

QPushButton.cyber-btn-secondary {
    background-color: #1C1F2E;
    color: #FFFFFF;
    border: 1px solid #2B3045;
    border-radius: 6px;
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 1px;
    padding: 9px 18px;
}

QPushButton.cyber-btn-secondary:hover {
    background-color: #24283B;
    border: 1px solid #00E5FF;
    color: #00E5FF;
}

QPushButton.cyber-btn-danger {
    background-color: #FF0552;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    font-weight: 800;
    font-size: 11px;
    letter-spacing: 1.2px;
    padding: 10px 22px;
}

QPushButton.cyber-btn-danger:hover {
    background-color: #FF2E6D;
}

/* ── Sliders ─────────────────────────────────────────────────────────────── */

QSlider::groove:horizontal {
    height: 6px;
    background-color: #222533;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background-color: #00E5FF;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: #FFFFFF;
    border: 2px solid #00E5FF;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background-color: #00E5FF;
    border: 2px solid #FFFFFF;
}

/* ── Progress Bars ───────────────────────────────────────────────────────── */

QProgressBar {
    background-color: #1C1F2E;
    border: 1px solid #262B3D;
    border-radius: 4px;
    height: 12px;
    text-align: center;
    color: #FFFFFF;
    font-size: 9px;
    font-weight: 700;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #00E5FF, stop:1 #00A6CC);
    border-radius: 3px;
}

/* ── Tables & Lists ──────────────────────────────────────────────────────── */

QTableWidget {
    background-color: #14161F;
    border: 1px solid #222533;
    gridline-color: #1E2230;
    border-radius: 6px;
}

QHeaderView::section {
    background-color: #0E1017;
    color: #8E92A4;
    padding: 8px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    border: none;
    border-bottom: 1px solid #222533;
}

/* ── Scrollbars ──────────────────────────────────────────────────────────── */

QScrollBar:vertical {
    border: none;
    background-color: #0E1017;
    width: 8px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: #24283B;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #00E5FF;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollArea {
    border: none;
    background-color: transparent;
}
